{
  "expo": {
    "name": "BaseSecrète",
    "slug": "basesecrete",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "react-native-libsodium",
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "BaseSecrète accède à tes photos pour que tu puisses en envoyer, chiffrées, dans tes groupes.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "BaseSecrète accède à tes photos pour enregistrer celles que tu télécharges depuis un groupe.",
          "savePhotosPermission": "BaseSecrète enregistre dans ta galerie les photos que tu choisis de télécharger depuis un groupe.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "backgroundColor": "#000000",
    "scheme": "basesecrete"
  }
}
