{
  "expo": {
    "name": "BaseSecrete",
    "slug": "basesecrete",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "owner": "8max",
    "ios": {
      "bundleIdentifier": "com.lipreux.basesecrete",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lipreux.basesecrete",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "./plugins/withDisplayName",
        "BaseSecrète"
      ],
      "./plugins/withHiddenRecents",
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "BaseSecrète accède à tes photos pour que tu puisses en envoyer, chiffrées, dans tes groupes.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "BaseSecrète accède à tes photos pour enregistrer celles que tu télécharges depuis un groupe.",
          "savePhotosPermission": "BaseSecrète enregistre dans ta galerie les photos que tu choisis de télécharger depuis un groupe.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "BaseSecrète utilise le micro pour enregistrer les vocaux que tu envoies, chiffrés, dans tes groupes.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-sqlite"
    ],
    "backgroundColor": "#000000",
    "scheme": "basesecrete",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e1a7f270-2953-4e39-b07b-d30ff420e85e"
      }
    }
  }
}
